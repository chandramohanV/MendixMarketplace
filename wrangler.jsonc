// Cloudflare Workers deployment: `npm run deploy` (builds the app, then uploads).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "component-marketplace",
  "account_id": "c02513a3c03fa393f2f92be6f0327980",
  "main": "server/worker.ts",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    // Client-side routes (/browse, /studio, ...) fall back to index.html.
    "not_found_handling": "single-page-application",
    // Only API calls run the Worker; everything else is a static asset (free, unmetered).
    "run_worker_first": ["/api/*"],
  },
  "kv_namespaces": [{ "binding": "STUDIO_KV" }],
  "observability": { "enabled": true },
}
